.{
    .name = .skim,
    .version = "0.1.0",
    .fingerprint = 0x9b7039a4e0a0e64f,
    .minimum_zig_version = "0.16.0",

    .dependencies = .{
        // TUI library - pinned to c060d31 (vaxis 0.6.0), the first uucode-based
        // release. uucode replaced zg, so `vaxis.Unicode` is gone and gwidth is
        // the 2-arg gwidth(str, method) against comptime tables; see
        // src/rendering/width.zig. Do not move back to a zg-based vaxis (0.5.x):
        // those need the 3-arg gwidth and a Window.unicode field, and predate 0.16.
        .vaxis = .{
            .url = "git+https://github.com/rockorager/libvaxis#c060d314930c5552b99a89278a6a695baf0352da",
            .hash = "vaxis-0.6.0-BWNV_LC4CwBka_bJk8SOXqzCM-nyQH00jzdL0kUhGwRE",
        },

        // Official tree-sitter Zig bindings (latest commit with Zig 0.16 support)
        .@"tree-sitter" = .{
            .url = "git+https://github.com/tree-sitter/zig-tree-sitter#b562510b5563dcf3b7fcac4a5fe9d60834c84667",
            .hash = "tree_sitter-0.26.0-8heIf-vDAQDh0HhAAUVwVZFmLrwSKMZl5gRaVFqtas0W",
        },

        // Language grammars - will be compiled from C sources
        .@"tree-sitter-javascript" = .{
            .url = "git+https://github.com/tree-sitter/tree-sitter-javascript#58404d8cf191d69f2674a8fd507bd5776f46cb11",
            .hash = "N-V-__8AANlfOQDpOAP-6YMQeJ2nQetX1OpUshQr903bnIHU",
        },
        .@"tree-sitter-typescript" = .{
            .url = "git+https://github.com/tree-sitter/tree-sitter-typescript#75b3874edb2dc714fb1fd77a32013d0f8699989f",
            .hash = "N-V-__8AAJZtIQHTLStHg_0TegWiaX-N1przeeHzJp9x9b6z",
        },
        .@"tree-sitter-python" = .{
            .url = "git+https://github.com/tree-sitter/tree-sitter-python#26855eabccb19c6abf499fbc5b8dc7cc9ab8bc64",
            .hash = "N-V-__8AAOiqPgC9tH5tYSAYNsMWLoPiSxcmkHvIhMnezomx",
        },
        .@"tree-sitter-rust" = .{
            .url = "git+https://github.com/tree-sitter/tree-sitter-rust#261b20226c04ef601adbdf185a800512a5f66291",
            .hash = "N-V-__8AABQ_bgA3wd_JlsmweudTSG2JMayVIUKs3uUw85OW",
        },
        .@"tree-sitter-go" = .{
            .url = "git+https://github.com/tree-sitter/tree-sitter-go#2346a3ab1bb3857b48b29d779a1ef9799a248cd7",
            .hash = "N-V-__8AAM9cIgDttbrvbwLWFB0JPplu_2KtCWu7__79EjIT",
        },
        // The v1.1.2 release tarball, not a git ref. Every commit since that tag
        // added a `build.zig.zon` with no `fingerprint` field, which 0.16 requires
        // of dependencies, so fetching any of them fails outright. v1.1.2 predates
        // the manifest entirely and so fetches as a plain file package, exactly
        // like the grammars above. Only the C sources are used - build.zig compiles
        // them itself - so the missing manifest costs nothing; the parser is ABI 14
        // against a runtime whose floor is 13. Move to a git ref once upstream
        // lands a fingerprint.
        .@"tree-sitter-zig" = .{
            .url = "https://github.com/tree-sitter-grammars/tree-sitter-zig/archive/refs/tags/v1.1.2.tar.gz",
            .hash = "N-V-__8AAN6NXgCZxLUnqe4620P_FqHrEY8PHTA1-VlOn4yX",
        },
        .@"tree-sitter-c" = .{
            .url = "git+https://github.com/tree-sitter/tree-sitter-c#ae19b676b13bdcc13b7665397e6d9b14975473dd",
            .hash = "N-V-__8AANxPSADtRZNZbKidAJYnL1fypqkbR-SuTdd7NtGk",
        },
        .@"tree-sitter-cpp" = .{
            .url = "git+https://github.com/tree-sitter/tree-sitter-cpp#12bd6f7e96080d2e70ec51d4068f2f66120dde35",
            .hash = "N-V-__8AAEdrjQHRjdxKFPjY1e82ERi7ZwQ4YxfmmsaIEuvc",
        },
        .@"tree-sitter-json" = .{
            .url = "git+https://github.com/tree-sitter/tree-sitter-json#001c28d7a29832b06b0e831ec77845553c89b56d",
            .hash = "N-V-__8AAHNaAgD6kjK3HX6lAf89chPqS5zIm0tLpvBQLOtX",
        },
        .@"tree-sitter-toml" = .{
            .url = "git+https://github.com/tree-sitter-grammars/tree-sitter-toml#64b56832c2cffe41758f28e05c756a3a98d16f41",
            .hash = "N-V-__8AAKI7BABbJ5LWswYbVPhQVdmSYR9zKxmZ7ob_RSNI",
        },
        .@"tree-sitter-markdown" = .{
            .url = "git+https://github.com/tree-sitter-grammars/tree-sitter-markdown#2dfd57f547f06ca5631a80f601e129d73fc8e9f0",
            .hash = "N-V-__8AABcZUwBZelO8MiLRwuLD1Wk34qHHbXtS4UW3Khys",
        },
        .@"tree-sitter-css" = .{
            .url = "git+https://github.com/tree-sitter/tree-sitter-css#dda5cfc5722c429eaba1c910ca32c2c0c5bb1a3f",
            .hash = "N-V-__8AAKwvEACP3YMpMDoRyyZPOdDN1n-zdTZRWTc3uufz",
        },
        .@"tree-sitter-bash" = .{
            .url = "git+https://github.com/tree-sitter/tree-sitter-bash#a06c2e4415e9bc0346c6b86d401879ffb44058f7",
            .hash = "N-V-__8AANjenwCy_cXlIbU8nqBzGxMlEHVokLZJYrmIXtoz",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "README.md",
    },
}

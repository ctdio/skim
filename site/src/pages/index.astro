---
import Landing from '../layouts/Landing.astro';
import HeroTerminal from '../components/HeroTerminal.astro';
import ProblemTerminal from '../components/ProblemTerminal.astro';
import ArrowLongRight from 'astro-heroicons/outline/ArrowLongRight.astro';
import { withBase } from '../lib/base';

const docsHref = withBase('/docs/getting-started/overview');
const buildHref = withBase('/docs/getting-started/build-from-source');
const keybindingsHref = withBase('/docs/reference/keybindings');
const repoHref = 'https://github.com/ctdio/skim';

// Paste-friendly form of the install snippet: shell commands only — no leading
// `$ ` prompts, no trailing `# …` inline comments — so the copy button drops a
// runnable block onto the clipboard.
const installCommands = [
  'git clone https://github.com/ctdio/skim.git',
  'cd skim',
  'zig build -Doptimize=ReleaseFast',
  './zig-out/bin/skim',
].join('\n');

// Each of these is checkable against the source. Keep it that way — if a claim
// here stops being true, it is a bug in the page, not a rounding error.
const mechanics = [
  {
    lead: 'It runs `git diff`.',
    body: 'Not a reimplementation. Skim spawns git, parses the output, and renders it. Working directory, staged, a single ref, or a range.',
  },
  {
    lead: 'It draws the diff itself.',
    body: 'The command runs with `--no-color --no-ext-diff`, so what you see is skim rendering the change, not your pager and not an external diff tool.',
  },
  {
    lead: 'The diff streams.',
    body: 'Files render as they parse, so the first one is on screen while git is still writing the rest. A 20MB single-file diff parses in 13ms.',
  },
  {
    lead: 'Highlighting runs on its own thread.',
    body: 'Tree-sitter parses in a background worker. A slow parse costs you a late repaint, never a dropped keystroke.',
  },
];

const features = [
  {
    kb: 'hjkl · Ctrl-n/p',
    title: 'Modal navigation',
    body: 'hjkl moves by line, Ctrl-n and Ctrl-p move file to file. The modes and motions are the vim ones.',
  },
  {
    kb: 's · Tab',
    title: 'Unified and side-by-side',
    body: 'One key switches the layout. Hunk mode cycles between all lines, additions only, and deletions only.',
  },
  {
    kb: '13 grammars',
    title: 'Tree-sitter highlighting',
    body: 'Real grammars, not regex. Parsing runs off the render thread, so a large file does not stall the scroll.',
  },
  {
    kb: 'Ctrl-p · :',
    title: 'Command palette',
    body: 'Ctrl-p fuzzy-finds a file in the diff. A colon runs a command by name. Neither one is a menu.',
  },
  {
    kb: '/ · f t F T',
    title: 'Search and find',
    body: 'Smart-case search runs across every file in the diff. f, t, F, and T move within the current line.',
  },
  {
    kb: 'Enter · y · Y',
    title: 'Inline comments',
    body: 'Enter attaches a comment to the line under the cursor. y copies one to the clipboard, Y copies all of them.',
  },
  {
    kb: 'r · B',
    title: 'Refresh and blame',
    body: 'r reloads the diff from git and keeps your position. B toggles git blame in the gutter.',
  },
  {
    kb: 'a · A · S',
    title: 'Staging and Graphite',
    body: 'a stages the current file, A stages all of them. S opens the Graphite stack to move between stacked PRs.',
  },
  {
    kb: 'Ctrl-e',
    title: 'Agent panel',
    body: 'An agent runs in a side panel over ACP. @file embeds a file from the diff into the prompt.',
  },
];
---

<Landing>
  <!-- Hero -->
  <section class="sk-hero">
    <div class="sk-wrap">
      <h1 class="sk-h1">A code review TUI that stays out of the way.</h1>
      <p class="sk-lede">
        Skim reads <code class="sk-mono">git diff</code> and renders it as a
        navigable buffer. Move file to file, switch unified and side-by-side,
        comment on a line, stage a hunk. It shells out to git, so it runs in any
        repo without setup.
      </p>
      <div class="sk-cta-row">
        <a class="sk-btn sk-btn-primary" href={buildHref}>
          Build from source <ArrowLongRight class="sk-btn-arrow" />
        </a>
        <a class="sk-btn sk-btn-ghost" href={docsHref}>Read the docs</a>
      </div>
    </div>
    <div class="sk-wrap">
      <HeroTerminal />
    </div>
  </section>

  <!-- How it works -->
  <section class="sk-section" aria-labelledby="mechanics-h">
    <div class="sk-wrap">
      <p class="sk-kicker">How it works</p>
      <h2 class="sk-h2" id="mechanics-h">It shells out to git.</h2>
      <div class="sk-two">
        <ul class="sk-prob-list">
          {
            mechanics.map((p, i) => (
              <li>
                <span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="body">
                  <b>{p.lead}</b>{' '}
                  {/* `body` is authored with markdown-style backticks, but this is
                      plain-text interpolation, not markdown — split them out into
                      real code spans or the backticks print as characters. */}
                  {p.body
                    .split(/(`[^`]+`)/)
                    .map((part) =>
                      part.startsWith('`') ? <code class="sk-mono">{part.slice(1, -1)}</code> : part,
                    )}
                </span>
              </li>
            ))
          }
        </ul>

        <ProblemTerminal />
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="sk-section" aria-labelledby="features-h">
    <div class="sk-wrap">
      <p class="sk-kicker">What's inside</p>
      <h2 class="sk-h2" id="features-h">What it does.</h2>
      <p class="sk-section-lead">
        Every feature is a keybinding. The keys are listed with each one, and
        the full set is in the keybindings reference.
      </p>
      <div class="sk-features">
        {
          features.map((f) => (
            <article class="sk-feat">
              <span class="kb sk-mono">{f.kb}</span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Install -->
  <section class="sk-section sk-install" aria-labelledby="install-h">
    <div class="sk-wrap">
      <p class="sk-kicker">Install</p>
      <h2 class="sk-h2" id="install-h" style="margin-inline:auto">Build it from source.</h2>
      <p class="sk-section-lead" style="margin-inline:auto;text-align:center">
        Skim needs Zig 0.15.1 and git. There is no other dependency. The binary
        lands at <code class="sk-mono">./zig-out/bin/skim</code>.
      </p>
      <div class="sk-codeblock">
        <div class="sk-copy">
          <span aria-live="polite"></span>
          <button
            type="button"
            class="sk-copy-btn"
            aria-label="Copy"
            data-copied="Copied!"
            data-code={installCommands}
          ></button>
        </div>
        <pre><code><span class="cprompt">$</span> git clone https://github.com/ctdio/skim.git
<span class="cprompt">$</span> cd skim
<span class="cprompt">$</span> zig build -Doptimize=ReleaseFast   <span class="ccomment"># optimized binary</span>
<span class="cprompt">$</span> ./zig-out/bin/skim                 <span class="ccomment"># review working-dir changes</span></code></pre>
      </div>
      <div class="sk-cta-row" style="margin-top:1.5rem">
        <a class="sk-btn sk-btn-primary" href={buildHref}>Build from source <ArrowLongRight class="sk-btn-arrow" /></a>
        <a class="sk-btn sk-btn-ghost" href={keybindingsHref}>See all keybindings</a>
      </div>
    </div>
  </section>
</Landing>

<!-- Landing-scoped copy-on-hover for the install block. Mirrors the docs
     (Expressive Code) UX — click the button, the runnable commands land on the
     clipboard, and a green "Copied!" bubble confirms — without touching the
     shared EC copy styling. -->
<script>
  function fallbackCopy(text: string): boolean {
    const el = document.createElement('textarea');
    el.value = text;
    el.setAttribute('readonly', '');
    el.style.position = 'absolute';
    el.style.left = '-9999px';
    document.body.appendChild(el);
    el.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {
      ok = false;
    }
    document.body.removeChild(el);
    return ok;
  }

  document.querySelectorAll<HTMLButtonElement>('.sk-codeblock .sk-copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code') ?? '';
      let ok = false;
      try {
        await navigator.clipboard.writeText(code);
        ok = true;
      } catch {
        ok = fallbackCopy(code);
      }
      const live = btn.parentElement?.querySelector('[aria-live]');
      if (!ok || !live || live.querySelector('.feedback')) return;

      const bubble = document.createElement('div');
      bubble.className = 'feedback';
      bubble.textContent = btn.getAttribute('data-copied') ?? 'Copied!';
      live.append(bubble);
      // Force a reflow so the entry transition runs from the hidden state.
      void bubble.offsetWidth;
      requestAnimationFrame(() => bubble.classList.add('show'));
      setTimeout(() => bubble.classList.remove('show'), 1500);
      setTimeout(() => bubble.remove(), 2500);
    });
  });
</script>

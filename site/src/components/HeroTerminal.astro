---
/**
 * The hero: a real, running skim.
 *
 * The frame paints as a loading panel, and a script swaps a live xterm.js
 * terminal in over it. The terminal runs the wasm build of skim (`zig build
 * web`, gzipped into `public/demo/` by `scripts/sync-web-assets.sh`) through
 * the loader in `web/skim.js`. Every frame a visitor sees is the real Zig
 * renderer. Nothing in the hero is a mockup.
 *
 * The load is deliberate about cost and fit:
 *   - Nothing downloads until the hero is on screen, and nothing downloads at
 *     all for a visitor who asked for less data.
 *   - The module and xterm.js load as separate chunks.
 *   - The module loads before any DOM change, so a failure leaves the loading
 *     panel in place and it says so.
 *   - The panel carries a meter, because the module is about half a megabyte
 *     and the frame shows nothing until it lands.
 *
 * The frame is locked to a 4:3 landscape box (`aspect-ratio` on `.term`), and
 * the terminal fits itself to that box, so the hero never resizes.
 *
 * Once the terminal is live it plays itself. `CHAPTERS` below is a tour written
 * as key scripts and pressed on a timer by `src/lib/demo-autoplay.ts`. Skim
 * renders every frame, so the tour cannot drift from the real thing. Tabs above
 * the frame jump to a chapter, and the tour stands down as soon as the visitor
 * types.
 */
---

<div class="sk-hero-term" data-hero-root>
  <!-- The caption for the live terminal. It stays hidden until there is one,
       because the loading panel inside the frame speaks for itself until then. -->
  <p class="sk-hero-hint" data-hero-hint hidden>
    <span class="sk-hero-dot"></span>
    <span data-hero-hint-text></span>
  </p>

  <!-- Chapter tabs for the tour. The script fills this in once the terminal is
       live, because a tab that cannot drive anything is worse than no tab. -->
  <div
    class="term-tabs"
    data-hero-tabs
    hidden
    role="toolbar"
    aria-orientation="horizontal"
    aria-label="Demo chapters"
  >
  </div>

  <div class="term">
    <div class="term-chrome">
      <div class="term-lights">
        <span style="background:#ff5f57"></span>
        <span style="background:#febc2e"></span>
        <span style="background:#28c840"></span>
      </div>
      <span class="term-title">skim — reviewing the browser build</span>
    </div>

    <div class="term-stage">
      <!-- What the frame holds until the module lands. It fills the same box
           the terminal takes over, so the swap moves nothing. -->
      <div class="sk-term-loading" data-hero-placeholder>
        <p class="sk-term-loading-label" data-hero-loading-label>
          Loading skim…
        </p>
        <span class="sk-hero-progress" data-hero-progress>
          <span class="sk-hero-progress-fill" data-hero-progress-fill></span>
        </span>
      </div>
      <div class="sk-hero-live" data-hero-live hidden></div>
    </div>
  </div>
</div>

<script>
  // xterm's stylesheet is static on purpose. Vite hoists it into the page
  // stylesheet either way, and importing it dynamically leaves a dangling CSS
  // chunk reference that 404s at mount time.
  import '@xterm/xterm/css/xterm.css';
  import { DEMO_DIFF } from '../lib/demo-diff';
  import { createAutoplay, typed } from '../lib/demo-autoplay';
  import type { Autoplay, Chapter, TourStatus } from '../lib/demo-autoplay';
  import { mountLiveTerminal, wantsLiveTerminal } from '../lib/live-terminal';
  import type { Progress } from '../lib/live-terminal';

  /**
   * The tour, as key scripts.
   *
   * These are the moments the old hand-built hero cross-faded through, plus the
   * help overlay. Every one runs the real keys: `src/web/session.zig` now maps
   * the whole browser-serviceable half of normal mode, the command palette
   * included.
   *
   * Every script starts from the top of the diff in normal mode — the driver
   * guarantees that — and `exit` returns whatever the chapter changed.
   *
   * `hotkey` and `blurb` are for the page, not the driver: the tab strip is the
   * keybinding legend, and the caption says what the keys are doing while they
   * run. A visitor who watches the whole tour has read the seven keys that matter.
   */
  type HeroChapter = Chapter & { hotkey: string; blurb: string };

  const CHAPTERS: HeroChapter[] = [
    {
      label: 'Navigate',
      hotkey: 'j k',
      blurb: 'j and k move a line, ]h jumps to the next change, l opens the next file.',
      // Read a few lines, jump change to change, then step into the next file.
      // The pauses are what make it read as someone working rather than a key
      // that is stuck down.
      keys: [
        'j', 'j', 'j', 340, 'j', 'j',
        420, ']', 'h',
        640, 'j', 'j', 380, ']', 'h',
        700, 'l',
      ],
      hold: 2000,
    },
    {
      label: 'Find a file',
      hotkey: 'Ctrl-p',
      blurb: 'Ctrl-p lists every file in the diff and filters as you type.',
      // Three of the eight files in this commit match "loading", so the list
      // narrows to a group rather than straight to one answer.
      keys: [420, 'Ctrl-p', 780, ...typed('loading'), 800, 'Enter'],
      hold: 2600,
    },
    {
      label: 'Side-by-side',
      hotkey: 's',
      blurb: 's switches between the unified and side-by-side layouts.',
      keys: [400, 's', 900, 'j', 'j', 'j', 'j'],
      cycle: { key: 's', length: 2 },
      hold: 3000,
    },
    {
      label: 'Old and new',
      hotkey: 'Tab',
      blurb: 'Tab narrows the diff to the new lines, then to the old, then back to both.',
      // Park on the one hunk in this commit that rewrites a block — nine lines
      // added over seven removed — because that is where the filter earns its
      // keep. Read the new version alone, then the old one alone.
      keys: [
        ']', 'h', ']', 'h', ']', 'h', ']', 'h',
        900, 'Tab', 2200, 'Tab', 2200, 'Tab',
      ],
      // Three presses is a full turn, so the script leaves the filter where it
      // found it. The cycle covers the run that is cut short part-way.
      cycle: { key: 'Tab', length: 3 },
      hold: 1800,
    },
    {
      label: 'Search',
      hotkey: '/',
      blurb: '/ searches every file in the review, and n walks the matches.',
      // `stream` is in every file of this diff, so `n` walks across files and
      // shows what a search over a whole review looks like.
      keys: ['/', 260, ...typed('stream'), 420, 'Enter', 950, 'n', 950, 'n'],
      // Escape alone leaves the match count in the status bar, because normal
      // mode has no key that clears a committed search. Opening search again
      // does clear it: `App.startSearch` resets the state before it reads.
      exit: ['/', 'Escape'],
      hold: 2200,
    },
    {
      label: 'Comment',
      hotkey: 'Enter',
      blurb: 'Enter opens a comment on the line under the cursor.',
      // Enter opens the editor on a code line, so walk onto one first: the top
      // of the diff is the file header and the hunk header.
      keys: [
        'j', 'j', 'j', 'j', 'j', 'j',
        520, 'Enter', 420,
        ...typed('does this need to be behind the flag?'),
        520, 'Enter',
      ],
      exit: ['D'],
      hold: 3000,
    },
    {
      label: 'Help',
      hotkey: '?',
      blurb: '? lists every key there is, without leaving the diff.',
      keys: [400, '?'],
      exit: ['Escape'],
      hold: 4000,
    },
  ];

  const root = document.querySelector<HTMLElement>('[data-hero-root]');
  const live = document.querySelector<HTMLElement>('[data-hero-live]');
  const placeholder = document.querySelector<HTMLElement>('[data-hero-placeholder]');
  const label = document.querySelector<HTMLElement>('[data-hero-loading-label]');
  const hint = document.querySelector<HTMLElement>('[data-hero-hint]');
  const hintText = document.querySelector<HTMLElement>('[data-hero-hint-text]');
  const meter = document.querySelector<HTMLElement>('[data-hero-progress]');
  const meterFill = document.querySelector<HTMLElement>('[data-hero-progress-fill]');
  const tabs = document.querySelector<HTMLElement>('[data-hero-tabs]');

  if (root && live && placeholder && label && hint && hintText && meter && meterFill && tabs) {
    if (wantsLiveTerminal()) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          mount().catch(() => showFailure());
        },
        { rootMargin: '200px' },
      );
      io.observe(root);
    } else {
      // A data-saver visitor gets no download and so no terminal. Say that,
      // rather than leave the frame loading something that never arrives.
      meter.hidden = true;
      label.textContent = 'The live demo is off while Data Saver is on.';
    }
  }

  /**
   * The caption under the tab strip.
   *
   * While the tour plays it explains the chapter on screen, which is where the
   * hero does its teaching. While the visitor has the terminal it says so, and
   * the countdown matters: a frame that has stopped moving looks broken unless
   * the page says what happens next and how to keep it that way.
   */
  function captionFor(status: TourStatus, chapter: number): string {
    if (status.kind === 'playing') {
      return `Live in your browser — ${CHAPTERS[chapter].blurb}`;
    }
    if (status.kind === 'held') {
      return 'Paused — the terminal is yours. Type anything; ? lists every key.';
    }
    return `The tour resumes in ${status.seconds}s. Click the terminal to keep it.`;
  }

  let autoplay: Autoplay | null = null;

  // What the caption is written from: which chapter is on screen, and who has
  // the terminal. Both change on their own schedule, so they are kept here and
  // the caption is repainted from the pair.
  let chapter = 0;
  let status: TourStatus = { kind: 'playing' };

  async function mount(): Promise<void> {
    const terminal = await mountLiveTerminal({
      host: live!,
      diff: DEMO_DIFF,
      onProgress: showProgress,
      // The visitor is driving now. The tour steps back and waits for them to
      // go idle before it takes the cursor again.
      onInput: () => autoplay?.yieldToVisitor(),
      reveal: () => {
        live!.hidden = false;
        placeholder!.hidden = true;
        hintText!.textContent = captionFor({ kind: 'playing' }, 0);
        hint!.classList.add('is-live');
        hint!.hidden = false;
      },
    });

    const bars: HTMLElement[] = [];
    const buttons = CHAPTERS.map((chapter, index) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'term-tab';
      button.setAttribute('aria-pressed', String(index === 0));
      // One tab stop for the whole strip. Arrow keys move within it, which is
      // the toolbar pattern — six separate stops between the nav and the
      // terminal would be six things to page past.
      button.tabIndex = index === 0 ? 0 : -1;

      const hotkey = document.createElement('kbd');
      hotkey.className = 'term-tab-key';
      hotkey.textContent = chapter.hotkey;

      const text = document.createElement('span');
      text.className = 'term-tab-label';
      text.textContent = chapter.label;

      const bar = document.createElement('span');
      bar.className = 'term-tab-progress';
      bars.push(bar);

      // The bar goes first so the two positioned labels paint over it.
      button.append(bar, hotkey, text);

      // Clicking a tab is a request to hand the terminal back to the tour, so
      // drop the focus the terminal may be holding. Without this the tour would
      // play on while the caption still said the visitor was driving.
      button.addEventListener('click', () => {
        if (live!.contains(document.activeElement)) {
          (document.activeElement as HTMLElement).blur();
        }
        autoplay?.play(index);
      });
      tabs!.append(button);
      return button;
    });
    tabs!.hidden = false;

    tabs!.addEventListener('keydown', (event) => {
      const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (step === 0) return;
      event.preventDefault();
      const from = buttons.indexOf(document.activeElement as HTMLButtonElement);
      const next = (from + step + buttons.length) % buttons.length;
      buttons.forEach((button, n) => (button.tabIndex = n === next ? 0 : -1));
      buttons[next].focus();
    });

    autoplay = createAutoplay({
      terminal,
      host: root!,
      chapters: CHAPTERS,
      onChapter: (index, duration) => {
        chapter = index;
        buttons.forEach((button, n) =>
          button.setAttribute('aria-pressed', String(n === index)),
        );
        runProgress(bars, index, duration);
        paintCaption();
      },
      onStatus: (next) => {
        status = next;
        paintCaption();
        // A paused chapter restarts from its first key rather than carrying on,
        // so the bar goes back to empty rather than freezing part-way.
        if (next.kind !== 'playing') runProgress(bars, -1, 0);
      },
    });

    // xterm puts the focus on a textarea inside the host, so watch the host.
    live!.addEventListener('focusin', () => autoplay?.setFocused(true));
    live!.addEventListener('focusout', () => autoplay?.setFocused(false));
  }

  /** Write the caption, and mark the strip and the dot when the tour is idle. */
  function paintCaption(): void {
    const paused = status.kind !== 'playing';
    hintText!.textContent = captionFor(status, chapter);
    hint!.classList.toggle('is-paused', paused);
    tabs!.classList.toggle('is-paused', paused);
  }

  /**
   * Draw the chapter clock: empty every bar, then run the active one to full
   * over the chapter's own length. One CSS transition, so it cannot drift from
   * the driver the way a second timer would.
   */
  function runProgress(bars: HTMLElement[], active: number, duration: number): void {
    bars.forEach((bar) => {
      bar.style.transition = 'none';
      bar.style.width = '0';
    });
    if (active < 0) return;

    const bar = bars[active];
    // Read a layout property so the reset above is committed. Without it the
    // browser collapses both writes into one frame and nothing animates.
    void bar.offsetWidth;
    bar.style.transition = `width ${duration}ms linear`;
    bar.style.width = '100%';
  }

  /**
   * Fill the meter as the module arrives. Until the first call the bar sweeps,
   * which is also all a visitor sees when the host compresses on the fly and so
   * sends no `Content-Length`.
   */
  function showProgress({ loaded, total }: Progress): void {
    if (!total) return;
    meter!.classList.add('is-measured');
    meterFill!.style.width = `${Math.min(100, Math.round((loaded / total) * 100))}%`;
  }

  /**
   * The terminal never came up. Put the loading panel back — the failure can
   * land after `reveal` hid it — and say so instead of leaving an empty frame.
   */
  function showFailure(): void {
    live!.hidden = true;
    placeholder!.hidden = false;
    meter!.hidden = true;
    label!.textContent = 'The live demo could not load.';
  }
</script>

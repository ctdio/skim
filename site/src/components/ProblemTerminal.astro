---
/**
 * The supporting terminal in "The old way": a second, real skim.
 *
 * Same load as the hero (`HeroTerminal.astro`) — the frame paints as a loading
 * panel, then the wasm build takes it over. The two share one download and one
 * compiled module (see `src/lib/live-terminal.ts`).
 *
 * This one steps through the changes with `]h`, which is what the section is
 * about. The stepping is a one-chapter script for the shared tour driver in
 * `src/lib/demo-autoplay.ts`: it pauses off screen, stands down the moment the
 * visitor presses a key of their own, and comes back once they go idle.
 */
---

<div class="term mini sk-mini-term" data-mini-root>
  <div class="term-chrome">
    <div class="term-lights">
      <span style="background:#ff5f57"></span>
      <span style="background:#febc2e"></span>
      <span style="background:#28c840"></span>
    </div>
    <span class="term-title">skim — ]h next change</span>
  </div>
  <div class="sk-mini-stage">
    <div class="sk-term-loading" data-mini-placeholder>
      <p class="sk-term-loading-label" data-mini-loading-label>Loading skim…</p>
    </div>
    <div class="sk-mini-live" data-mini-live hidden aria-label="Live skim demo"></div>
  </div>
</div>

<script>
  import '@xterm/xterm/css/xterm.css';
  import { PROBLEM_DIFF } from '../lib/demo-diff';
  import { createAutoplay } from '../lib/demo-autoplay';
  import type { Autoplay, Chapter } from '../lib/demo-autoplay';
  import { mountLiveTerminal, wantsLiveTerminal } from '../lib/live-terminal';

  /**
   * One chapter, pressed over and over: `]h`, `]h`, `]h`.
   *
   * The section is about jumping change to change, so that is the whole script.
   * The driver returns to the top of the diff between passes, which is what
   * makes it loop.
   */
  const CHAPTERS: Chapter[] = [
    {
      label: 'next change',
      keys: [']', 'h', 1600, ']', 'h', 1600, ']', 'h'],
      hold: 1600,
    },
  ];

  const root = document.querySelector<HTMLElement>('[data-mini-root]');
  const live = document.querySelector<HTMLElement>('[data-mini-live]');
  const placeholder = document.querySelector<HTMLElement>('[data-mini-placeholder]');
  const label = document.querySelector<HTMLElement>('[data-mini-loading-label]');

  if (root && live && placeholder && label) {
    if (wantsLiveTerminal()) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          mount().catch(() => {
            live.hidden = true;
            placeholder.hidden = false;
            label.textContent = 'The live demo could not load.';
          });
        },
        { rootMargin: '200px' },
      );
      io.observe(root);
    } else {
      label.textContent = 'The live demo is off while Data Saver is on.';
    }
  }

  let autoplay: Autoplay | null = null;

  async function mount(): Promise<void> {
    const terminal = await mountLiveTerminal({
      host: live!,
      diff: PROBLEM_DIFF,
      // Half a grid column on a wide screen, the full width on a phone, so it
      // asks for fewer columns than the hero and starts from a smaller glyph.
      font: { cols: 80, min: 8, max: 11 },
      onInput: () => autoplay?.yieldToVisitor(),
      reveal: () => {
        live!.hidden = false;
        placeholder!.hidden = true;
      },
    });

    autoplay = createAutoplay({ terminal, host: root!, chapters: CHAPTERS });

    // xterm puts the focus on a textarea inside the host, so watch the host.
    // The stepping stops while the visitor is in the terminal, whether or not
    // they have pressed anything yet.
    live!.addEventListener('focusin', () => autoplay?.setFocused(true));
    live!.addEventListener('focusout', () => autoplay?.setFocused(false));
  }
</script>

---
import '../styles/theme.css';
import '../styles/landing.css';
import { withBase } from '../lib/base';
import Sun from 'astro-heroicons/outline/Sun.astro';
import Moon from 'astro-heroicons/outline/Moon.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Skim — a keyboard-driven TUI for code reviews',
  description = 'Skim is a keyboard-driven TUI for code reviews, built in Zig. Vim-style navigation, unified & side-by-side diffs, tree-sitter highlighting, inline comments — with sub-10ms startup and 60 FPS scrolling.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const docsHref = withBase('/docs/getting-started/overview');
const repoHref = 'https://github.com/ctdio/skim';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="theme-color" content="#0b0d10" />
    <!-- Theme bootstrap: match Starlight's key + attribute so light/dark stays
         in sync across the landing page and the docs. Runs before paint to
         avoid a flash of the wrong theme. -->
    <script is:inline>
      (() => {
        const stored =
          typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="sk-landing">
    <a href="#main" class="sk-skip">Skip to content</a>
    <header class="sk-header">
      <div class="sk-wrap sk-nav">
        <a class="sk-brand" href={withBase('/')} aria-label="Skim home">
          <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect
              x="1.5"
              y="3.5"
              width="29"
              height="25"
              rx="5"
              fill="var(--tui-bg)"
              stroke="var(--sk-accent)"
              stroke-width="2"></rect>
            <rect x="7" y="10" width="12" height="2.4" rx="1.2" fill="var(--sk-add)"></rect>
            <rect x="7" y="15" width="16" height="2.4" rx="1.2" fill="var(--sk-del)"></rect>
            <rect x="7" y="20" width="9" height="2.4" rx="1.2" fill="var(--sk-dim)"></rect>
          </svg>
          <span>Skim</span>
        </a>
        <div class="sk-nav-spacer"></div>
        <nav class="sk-nav-links" aria-label="Primary">
          <a href={docsHref}>Docs</a>
          <a
            href={withBase('/docs/reference/keybindings')}
            class="sk-hide-sm">Keybindings</a
          >
          <a href={repoHref} rel="noopener">GitHub</a>
        </nav>
        <button
          class="sk-theme-toggle"
          type="button"
          id="sk-theme-toggle"
          aria-label="Toggle color theme"
        >
          <Moon class="sk-icon-moon" />
          <Sun class="sk-icon-sun" />
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="sk-footer">
      <div class="sk-wrap">
        <div class="sk-footer-grid">
          <div>
            <a class="sk-brand" href={withBase('/')} aria-label="Skim home">
              <svg width="24" height="24" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                <rect
                  x="1.5"
                  y="3.5"
                  width="29"
                  height="25"
                  rx="5"
                  fill="var(--tui-bg)"
                  stroke="var(--sk-accent)"
                  stroke-width="2"></rect>
                <rect x="7" y="10" width="12" height="2.4" rx="1.2" fill="var(--sk-add)"></rect>
                <rect x="7" y="15" width="16" height="2.4" rx="1.2" fill="var(--sk-del)"></rect>
                <rect x="7" y="20" width="9" height="2.4" rx="1.2" fill="var(--sk-dim)"></rect>
              </svg>
              <span>Skim</span>
            </a>
            <p class="sk-footer-blurb">
              A keyboard-driven TUI for code reviews, built in Zig. Review diffs
              at the speed of vim.
            </p>
          </div>
          <div>
            <h4>Docs</h4>
            <ul>
              <li><a href={withBase('/docs/getting-started/overview')}>Getting Started</a></li>
              <li><a href={withBase('/docs/guides/navigating-diffs')}>Guides</a></li>
              <li><a href={withBase('/docs/reference/keybindings')}>Keybindings</a></li>
              <li><a href={withBase('/docs/integrations/agent-panel')}>Integrations</a></li>
            </ul>
          </div>
          <div>
            <h4>Project</h4>
            <ul>
              <li><a href={repoHref} rel="noopener">GitHub</a></li>
              <li><a href={`${repoHref}/blob/main/LICENSE`} rel="noopener">License (MIT)</a></li>
              <li><a href={`${repoHref}/issues`} rel="noopener">Issues</a></li>
            </ul>
          </div>
        </div>
        <div class="sk-footer-bottom">
          © {year} Skim contributors · MIT License · Built with Astro + Starlight
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById('sk-theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const next =
            document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
          document.documentElement.dataset.theme = next;
          try {
            localStorage.setItem('starlight-theme', next);
          } catch {}
        });
      })();
    </script>
  </body>
</html>
